{
  "name": "dsh-active-context",
  "version": "0.5.1",
  "description": "Model-authored active context compaction for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TTTPOB/dsh-active-context.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm --config.verify-deps-before-run=false build",
    "test:delivery": "node tests/delivery/run.mjs",
    "test": "node tests/run.mjs",
    "typecheck:source": "node tests/typecheck.mjs",
    "check": "pnpm --config.verify-deps-before-run=false typecheck:source && pnpm --config.verify-deps-before-run=false test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1-fork1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.1-fork1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session": "0.2.1-rc.1-fork1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.1-fork1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.1",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-include": "1.0.10"
  },
  "license": "MIT"
}
