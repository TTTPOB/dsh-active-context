{
  "name": "dsh-active-context",
  "version": "0.1.0",
  "description": "Model-authored active context compaction for DeepSeek Harness",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": { "node": ">=24" },
  "repository": { "type": "git", "url": "git+https://github.com/TTTPOB/dsh-active-context.git" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "README.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm --config.verify-deps-before-run=false build",
    "test:delivery": "node tests/delivery/run.mjs",
    "test": "node tests/acceptance/run.mjs",
    "typecheck:source": "node tests/acceptance/typecheck.mjs",
    "check": "pnpm --config.verify-deps-before-run=false typecheck:source && pnpm --config.verify-deps-before-run=false test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2-fork1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-rc.2-fork4",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "https://github.com/TTTPOB/deepseek-harness/releases/download/daily-driver-v0.1.7-rc.2-fork16/deepseek-ai-dsh-session-0.1.7-rc.2-fork1.tgz",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session-query": "https://github.com/TTTPOB/deepseek-harness/releases/download/daily-driver-v0.1.7-rc.2-fork17/deepseek-ai-dsh-session-query-0.1.7-rc.2-fork4.tgz",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.6.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT"
}
